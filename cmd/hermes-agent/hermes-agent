#!/usr/bin/env bash
set -euo pipefail

export PYTHONUTF8=1
export PYTHONIOENCODING=UTF-8
if locale -a 2>/dev/null | grep -Eiq '^en_US\.UTF-?8$'; then
  export LC_ALL=en_US.UTF-8
elif locale -a 2>/dev/null | grep -Eiq '^C\.UTF-?8$'; then
  export LC_ALL=C.UTF-8
else
  export LC_ALL=zh_CN.UTF-8
fi
export LANG="$LC_ALL"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="$SCRIPT_DIR/.runtime"
VENV_DIR="$RUNTIME_DIR/venv"
PYTHON="$VENV_DIR/bin/python"
STAMP="$RUNTIME_DIR/install.stamp"
REQUIREMENTS="$SCRIPT_DIR/requirements.lock"

mkdir -p "$RUNTIME_DIR"
if command -v sha256sum >/dev/null 2>&1; then
  EXPECTED_STAMP="$(sha256sum "$REQUIREMENTS" "$SCRIPT_DIR/vendor/hermes_runtime/pyproject.toml" | sha256sum | awk '{print $1}')"
else
  EXPECTED_STAMP="$(shasum -a 256 "$REQUIREMENTS" "$SCRIPT_DIR/vendor/hermes_runtime/pyproject.toml" | shasum -a 256 | awk '{print $1}')"
fi

if [[ ! -x "$PYTHON" || ! -f "$STAMP" || "$(cat "$STAMP")" != "$EXPECTED_STAMP" ]]; then
  echo "Preparing embedded Hermes Python runtime..."
  if command -v uv >/dev/null 2>&1; then
    uv venv --python 3.11 "$VENV_DIR"
    uv pip install --python "$PYTHON" -r "$REQUIREMENTS"
  else
    PYTHON_BOOTSTRAP="${PYTHON_BOOTSTRAP:-python3}"
    "$PYTHON_BOOTSTRAP" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' || {
      echo "Python 3.11+ or uv is required" >&2
      exit 1
    }
    "$PYTHON_BOOTSTRAP" -m venv "$VENV_DIR"
    "$PYTHON" -m pip install -r "$REQUIREMENTS"
  fi
  rm -rf \
    "$SCRIPT_DIR/vendor/hermes_runtime/build" \
    "$SCRIPT_DIR/vendor/hermes_runtime/hermes_agent.egg-info"
  printf '%s\n' "$EXPECTED_STAMP" > "$STAMP"
fi

exec "$PYTHON" "$SCRIPT_DIR/main.py" "$@"
