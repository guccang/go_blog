<!DOCTYPE html>
<html lang="zh-CN" data-page="public">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GUCCANG - 公开博客</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="/js/theme.js?v=4"></script>
    <link rel="stylesheet" href="/css/theme.css?v=4">
    <link rel="stylesheet" href="/css/public.css?v=unified-1">
</head>
<body>
    <!-- 顶部导航 -->
    <header class="top-nav">
        <div class="top-nav-inner site-shell site-hanging-nav">
            <a href="/main" class="nav-brand">
                <div class="brand-icon">G</div>
                <span class="brand-text">GUCCANG</span>
            </a>

            <div class="nav-search">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="search" placeholder="搜索公开博客..." autocomplete="off" class="nav-search-input">
            </div>

            <div class="nav-actions">
                <button class="btn-icon" onclick="toggleView()" title="切换视图">
                    <i id="view-icon" class="fas fa-th-large"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- 英雄区域 -->
    <section class="hero site-shell site-page-hero">
        <div class="hero-content site-page-hero__copy">
            <p class="site-kicker">PUBLIC READING ROOM</p>
            <h1 class="hero-title site-page-title">公开博客</h1>
            <p class="hero-subtitle site-page-description">探索被分享出来的思考、记录与长期写作。</p>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-value">{{.BLOGS_NUMBER}}</span>
                    <span class="hero-stat-label">篇文章</span>
                </div>
            </div>
        </div>
        <div class="site-page-hero__exhibit" aria-hidden="true"><span class="site-page-symbol" data-symbol="article"></span></div>
    </section>

    <!-- 博客列表 -->
    <main class="blog-main site-shell site-section">
        <div class="blog-grid" id="blog-container">
            {{range .LINKS}}
            <article class="blog-card">
                <a href="{{.URL}}" class="blog-card-inner">
                    <div class="blog-card-content">
                        <h2 class="blog-card-title">
                            {{if .IS_ENCRYPTED}}<i class="fas fa-lock"></i>{{end}}
                            {{if .IS_DIARY}}<i class="fas fa-book"></i>{{end}}
                            {{.DESC}}
                        </h2>
                        <div class="blog-card-footer">
                            {{if .ACCESS_TIME}}
                            <span class="blog-date">
                                <i class="far fa-calendar-alt"></i> {{.ACCESS_TIME}}
                            </span>
                            {{end}}
                        </div>
                    </div>
                    <div class="blog-card-arrow">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </a>
            </article>
            {{end}}
        </div>

        {{if not .LINKS}}
        <div class="empty-state site-empty-state">
            <span class="site-symbol" data-symbol="empty" aria-hidden="true"></span>
            <h2>暂无公开博客</h2>
            <p>这里还没有公开的博客文章，请稍后再来</p>
        </div>
        {{end}}
    </main>

    <!-- 底部 -->
    <footer class="page-footer">
        <div class="footer-inner">
            <span>公开博客数量: {{.BLOGS_NUMBER}}</span>
            <span class="footer-dot">·</span>
            <span>版本: {{.VERSION}}</span>
        </div>
    </footer>

    <script src="/js/utils.js"></script>
    <script src="/js/public.js"></script>
</body>
</html>
