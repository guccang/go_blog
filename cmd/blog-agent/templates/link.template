<!DOCTYPE html>
<html lang="zh-CN" data-page="link">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLOG - GUCCANG</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="/js/theme.js?v=5"></script>
    <link rel="stylesheet" href="/css/theme.css?v=5">
    <link rel="stylesheet" href="/css/link.css?v=unified-1">
</head>
<body class="library-page">
    <header class="library-header site-shell site-hanging-nav">
        <a class="library-brand" href="/main"><span>G</span><strong>BLOG</strong></a>
        <nav>
            <a href="/editor" class="library-write">写博客</a>
            <a href="/main">返回主页</a>
            <a class="library-account" href="/account">{{.USER_AVATAR}}</a>
        </nav>
    </header>

    <main class="library-shell site-shell">
        <section class="library-intro site-page-hero">
            <div class="site-page-hero__copy">
                <p class="site-kicker">PERSONAL WRITING ARCHIVE</p>
                <h1 class="site-page-title">博客档案</h1>
                <p class="site-page-description">在写下的文字里搜索、筛选和继续阅读。每一篇记录都是悬廊中的一份长期档案。</p>
            </div>
            <div class="site-page-hero__exhibit" aria-hidden="true">
                <span class="site-page-symbol" data-symbol="archive"></span>
                <strong class="library-count">{{.BLOGS_NUMBER}} 篇</strong>
            </div>
        </section>

        <header class="library-toolbar site-paper-panel">
            <div class="search-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input id="search" type="text" placeholder="搜索博客或输入高级命令…" class="search-input">
                <select id="search-command-select" class="search-command" title="高级命令" onchange="handleSearchCommand(this)">
                    <option value="">命令</option>
                    {{range .SEARCH_COMMANDS}}
                    <option value="{{.Name}}" data-hasparam="{{.HasParam}}" data-paramhint="{{.ParamHint}}">{{.DisplayName}}</option>
                    {{end}}
                </select>
            </div>
            <button class="btn-icon" onclick="toggleView()" title="切换视图" aria-label="切换内容视图">
                <i id="view-icon" class="fas fa-th-large"></i>
            </button>
        </header>

        <section class="section site-section">
            <div class="blog-filter-bar" id="blogFilterBar" role="group" aria-label="内容分类筛选"></div>
            <div class="blog-filter-empty" id="blogFilterEmpty" hidden>
                <i class="fas fa-filter-circle-xmark"></i>
                <div>
                    <strong>这个分类暂时没有内容</strong>
                    <button type="button" id="showAllBlogs">显示全部内容</button>
                </div>
            </div>

            <div class="blog-grid" id="blogContainer">
                {{range .LINKS}}
                <article class="blog-card{{if .IMAGE_URL}} has-media{{end}}" data-title="{{.DESC}}" data-diary="{{.IS_DIARY}}"
                         data-encrypted="{{.IS_ENCRYPTED}}" data-tech-doc="{{.IS_TECH_DOC}}">
                    <a href="{{.URL}}" class="blog-card-link">
                        {{if .IMAGE_URL}}
                        <img class="blog-card-image" src="{{.IMAGE_URL}}" alt="" loading="lazy" decoding="async">
                        {{end}}
                        <div class="blog-card-body">
                            {{if or .ACCESS_TIME .IS_ENCRYPTED .IS_DIARY}}
                            <div class="blog-card-meta">
                                {{if .ACCESS_TIME}}
                                <span class="blog-date">{{.ACCESS_TIME}}</span>
                                {{end}}
                                {{if .IS_ENCRYPTED}}<span class="protected-label"><i class="fas fa-lock"></i> 加密</span>{{end}}
                                {{if .IS_DIARY}}<span class="protected-label diary"><i class="fas fa-book"></i> 日记</span>{{end}}
                            </div>
                            {{end}}
                            <h2 class="blog-card-title">
                                {{.DESC}}
                            </h2>
                            <p class="blog-card-preview">{{.PREVIEW}}</p>
                        </div>
                    </a>
                </article>
                {{end}}
            </div>

            {{if .SHOW_LOAD_MORE}}
            <div class="load-more-wrap" id="loadMoreWrap" {{if lt (len .LINKS) 1}}hidden{{end}}>
                <button type="button" class="load-more-btn" id="loadMoreBlogs" data-offset="{{len .LINKS}}">
                    加载更多内容
                </button>
            </div>
            {{end}}

            {{if not .LINKS}}
            <div class="empty-state site-empty-state">
                <span class="site-symbol" data-symbol="empty" aria-hidden="true"></span>
                <h3>还没有博客</h3>
                <p><a href="/editor">写下第一篇博客</a></p>
            </div>
            {{end}}
        </section>
    </main>

    <script src="/js/utils.js"></script>
    <script src="/js/link.js?v=library-cards-1"></script>
</body>
</html>
