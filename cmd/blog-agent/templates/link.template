<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GUCCANG - 博客</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/link.css">
</head>
<body>
    <!-- 侧边栏导航 -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="/main" class="logo">
                <div class="logo-icon">G</div>
                <span class="logo-text">GUCCANG</span>
            </a>
        </div>

        <nav class="sidebar-nav">
            <a href="/editor" class="nav-item">
                <i class="fas fa-pen-to-square"></i>
                <span>写博客</span>
            </a>
            <a href="/todolist" class="nav-item" onclick="navigateToTodolist(event)">
                <i class="fas fa-check-square"></i>
                <span>每日任务</span>
            </a>
            <a href="/goal" class="nav-item">
                <i class="fas fa-flag-checkered"></i>
                <span>目标管理</span>
            </a>
            <a href="/monthgoal" class="nav-item">
                <i class="fas fa-calendar-alt"></i>
                <span>月度计划</span>
            </a>
            <a href="/yearplan" class="nav-item">
                <i class="fas fa-calendar"></i>
                <span>年度计划</span>
            </a>
            <a href="/exercise" class="nav-item">
                <i class="fas fa-dumbbell"></i>
                <span>锻炼管理</span>
            </a>
            <a href="/reading" class="nav-item">
                <i class="fas fa-book-open"></i>
                <span>读书记录</span>
            </a>
            <a href="/skill" class="nav-item">
                <i class="fas fa-bullseye"></i>
                <span>技能学习</span>
            </a>
            <a href="/taskbreakdown" class="nav-item">
                <i class="fas fa-list-check"></i>
                <span>任务拆解</span>
            </a>
        </nav>

        <div class="sidebar-divider"></div>

        <nav class="sidebar-nav">
            <a href="/statistics" class="nav-item">
                <i class="fas fa-chart-bar"></i>
                <span>访问统计</span>
            </a>
            <a href="/tools" class="nav-item">
                <i class="fas fa-toolbox"></i>
                <span>实用工具</span>
            </a>
            <a href="/lifecountdown" class="nav-item">
                <i class="fas fa-hourglass-half"></i>
                <span>人生倒计时</span>
            </a>
            <a href="/agent" class="nav-item">
                <i class="fas fa-robot"></i>
                <span>Agent</span>
            </a>
            <a href="/codegen" class="nav-item">
                <i class="fas fa-code"></i>
                <span>编码助手</span>
            </a>
            <a href="/config" class="nav-item">
                <i class="fas fa-gear"></i>
                <span>系统配置</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <a href="/public?account={{.USER_ACCOUNT}}" class="nav-item">
                <i class="fas fa-globe"></i>
                <span>公开博客</span>
            </a>
            <a href="/account" class="user-profile">
                <div class="user-avatar">{{.USER_AVATAR}}</div>
                <div class="user-info-text">
                    <span class="user-name">{{.USER_ACCOUNT}}</span>
                    <span class="user-role">Blogger</span>
                </div>
            </a>
        </div>
    </aside>

    <!-- 移动端遮罩 -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- 主内容区域 -->
    <main class="main-content">
        <!-- 顶部栏 -->
        <header class="top-bar">
            <button class="menu-toggle" id="menuToggle" onclick="toggleSidebar()">
                <i class="fas fa-bars"></i>
            </button>

            <div class="search-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input id="search" type="text" placeholder="搜索博客..." class="search-input">
                <select id="search-command-select" class="search-command" title="搜索命令" onchange="handleSearchCommand(this)">
                    <option value="">命令</option>
                    {{range .SEARCH_COMMANDS}}
                    <option value="{{.Name}}" data-hasparam="{{.HasParam}}" data-paramhint="{{.ParamHint}}">{{.DisplayName}}</option>
                    {{end}}
                </select>
            </div>

            <div class="header-actions">
                <button class="btn-icon" onclick="toggleView()" title="切换视图">
                    <i id="view-icon" class="fas fa-th-large"></i>
                </button>
            </div>
        </header>

        <!-- 欢迎区域 & 统计 -->
        <section class="welcome-section">
            <div class="welcome-text">
                <h1>欢迎回来</h1>
                <p>你共有 <strong>{{.BLOGS_NUMBER}}</strong> 篇博客</p>
            </div>
            <div class="quick-stats">
                <div class="stat-item">
                    <span class="stat-value">{{len .RECENT_LINKS}}</span>
                    <span class="stat-label">最近更新</span>
                </div>
            </div>
        </section>

        <!-- 最近查看 -->
        {{if .RECENT_LINKS}}
        <section class="section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-clock"></i> 最近查看
                </h2>
            </div>
            <div class="recent-scroll">
                {{range .RECENT_LINKS}}
                <a href="{{.URL}}" class="recent-card">
                    <div class="recent-avatar">
                        <span class="recent-char">{{.DESC}}</span>
                    </div>
                    <span class="recent-title">
                        {{if .IS_ENCRYPTED}}<i class="fas fa-lock"></i>{{end}}
                        {{if .IS_DIARY}}<i class="fas fa-book"></i>{{end}}
                        {{.DESC}}
                    </span>
                </a>
                {{end}}
            </div>
        </section>
        {{end}}

        <!-- 博客列表 -->
        <section class="section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-newspaper"></i> 全部博客
                </h2>
                <span class="section-badge">{{.BLOGS_NUMBER}}</span>
            </div>

            <div class="blog-grid" id="blogContainer">
                {{range .LINKS}}
                <article class="blog-card" data-title="{{.DESC}}" data-diary="{{.IS_DIARY}}" data-encrypted="{{.IS_ENCRYPTED}}">
                    <a href="{{.URL}}" class="blog-card-link">
                        <div class="blog-card-body">
                            <h3 class="blog-card-title">
                                {{if .IS_ENCRYPTED}}<i class="fas fa-lock lock-icon"></i>{{end}}
                                {{if .IS_DIARY}}<i class="fas fa-book diary-icon"></i>{{end}}
                                {{.DESC}}
                            </h3>
                            <div class="blog-card-meta">
                                {{if .ACCESS_TIME}}
                                <span class="blog-date"><i class="far fa-clock"></i> {{.ACCESS_TIME}}</span>
                                {{end}}
                            </div>
                        </div>
                        <div class="blog-card-arrow">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </a>
                </article>
                {{end}}
            </div>

            {{if not .LINKS}}
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <h3>还没有博客</h3>
                <p>点击右下角的 + 按钮开始写你的第一篇博客吧</p>
            </div>
            {{end}}
        </section>
    </main>

    <!-- 浮动按钮 -->
    <a href="/editor" class="fab fab-create" title="创建新博客">
        <i class="fas fa-plus"></i>
    </a>
    <a href="/assistant" class="fab fab-assistant" title="智能助手">
        <i class="fas fa-robot"></i>
    </a>

    <!-- 底部状态栏 -->
    <footer class="status-bar">
        <span>博客数量: {{.BLOGS_NUMBER}}</span>
        <span>版本: {{.VERSION}}</span>
    </footer>

    <script src="/js/move_assistant.js"></script>
    <script src="/js/utils.js"></script>
    <script src="/js/link.js"></script>


    <script>
    // 侧边栏切换
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('show');
    }

    // 处理搜索命令选择
    function handleSearchCommand(select) {
        const option = select.options[select.selectedIndex];
        if (!option || !option.value) return;
        const command = option.value;
        const hasParam = option.getAttribute('data-hasparam') === 'true';
        const paramHint = option.getAttribute('data-paramhint') || '';
        const searchInput = document.getElementById('search');
        if (!searchInput) return;
        let text = command;
        if (hasParam) text += ' ';
        searchInput.value = text;
        searchInput.focus();
        if (hasParam) {
            searchInput.setSelectionRange(text.length, text.length);
        } else {
            setTimeout(() => { if (searchInput.value === text) onSearch(); }, 100);
        }
        select.selectedIndex = 0;
    }

    // 导航到当日todolist
    function navigateToTodolist(event) {
        event.preventDefault();
        const today = new Date().toISOString().split('T')[0];
        window.location.href = `/todolist?date=${today}`;
    }

    // 初始化
    document.addEventListener('DOMContentLoaded', function() {
        // 设置最近查看的首字符
        document.querySelectorAll('.recent-char').forEach(function(el) {
            var title = el.textContent;
            if (title && title.length > 0) el.textContent = title.charAt(0);
        });

    });
    </script>
</body>
</html>
