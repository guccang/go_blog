<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>目标管理</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        * { box-sizing: border-box; }
        body { background: #0f0f1a; color: #e0e0e0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }

        .goal-container { max-width: 900px; margin: 0 auto; padding: 20px; }

        /* Header */
        .goal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
        .goal-header h2 { margin: 0; font-size: 22px; }
        .back-link { color: #888; text-decoration: none; font-size: 13px; }
        .back-link:hover { color: #4f46e5; }

        /* Tabs */
        .goal-tabs { display: flex; gap: 4px; background: #1a1a2e; border-radius: 12px; padding: 4px; margin-bottom: 16px; }
        .goal-tab { padding: 10px 24px; border-radius: 10px; cursor: pointer; color: #999; font-size: 14px; transition: all 0.2s; border: none; background: transparent; }
        .goal-tab:hover { color: #fff; }
        .goal-tab.active { background: #4f46e5; color: #fff; }

        /* Period Navigation */
        .period-nav { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 16px; padding: 10px 16px; background: #1e1e2e; border-radius: 12px; }
        .period-btn { padding: 6px 14px; border-radius: 8px; cursor: pointer; font-size: 13px; border: 1px solid #333; background: transparent; color: #aaa; transition: all 0.2s; }
        .period-btn:hover { border-color: #4f46e5; color: #fff; }
        .period-btn.today-btn { border-color: #4f46e5; color: #4f46e5; }
        .period-label { font-size: 14px; color: #e0e0e0; min-width: 160px; text-align: center; font-weight: 500; }

        /* View Toggle */
        .view-toggle { display: flex; gap: 4px; background: #1a1a2e; border-radius: 10px; padding: 3px; margin-bottom: 16px; width: fit-content; }
        .view-btn { padding: 6px 18px; border-radius: 8px; cursor: pointer; font-size: 13px; border: none; background: transparent; color: #999; transition: all 0.2s; }
        .view-btn:hover { color: #fff; }
        .view-btn.active { background: #4f46e5; color: #fff; }

        /* Cards */
        .goal-card { background: #1e1e2e; border-radius: 14px; padding: 20px; margin-bottom: 14px; }
        .goal-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
        .card-period { font-size: 13px; color: #888; }

        /* Status badges */
        .goal-status { font-size: 11px; padding: 3px 10px; border-radius: 6px; }
        .goal-status.active { background: #1e3a5f; color: #60a5fa; }
        .goal-status.completed { background: #14532d; color: #4ade80; }
        .goal-status.archived { background: #333; color: #888; }

        /* Overview */
        .goal-overview { width: 100%; min-height: 70px; background: #16162a; border: 1px solid #333; border-radius: 10px; color: #e0e0e0; padding: 12px; font-size: 14px; resize: vertical; font-family: inherit; margin-bottom: 10px; line-height: 1.5; }
        .goal-overview:focus { outline: none; border-color: #4f46e5; }
        .goal-actions { display: flex; gap: 8px; align-items: center; margin-bottom: 14px; }

        /* Progress */
        .goal-progress { margin-bottom: 10px; }
        .progress-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
        .progress-header span { font-size: 12px; color: #888; }
        .progress-bar { height: 5px; background: #333; border-radius: 3px; overflow: hidden; }
        .progress-fill { height: 100%; background: linear-gradient(90deg, #4f46e5, #7c3aed); border-radius: 3px; transition: width 0.4s ease; }

        /* Buttons */
        .btn { padding: 7px 16px; border-radius: 8px; cursor: pointer; font-size: 13px; border: none; transition: all 0.2s; }
        .btn-primary { background: #4f46e5; color: #fff; }
        .btn-primary:hover { background: #4338ca; }
        .btn-sm { padding: 4px 10px; font-size: 11px; border-radius: 6px; }
        .btn-xs { padding: 2px 7px; font-size: 10px; border-radius: 4px; }
        .btn-danger { background: transparent; color: #ef4444; border: 1px solid #ef4444; }
        .btn-danger:hover { background: #ef4444; color: #fff; }
        .btn-secondary { background: transparent; color: #aaa; border: 1px solid #444; }
        .btn-secondary:hover { border-color: #888; color: #fff; }
        .btn-outline { background: transparent; color: #4f46e5; border: 1px solid #4f46e5; }
        .btn-outline:hover { background: #4f46e5; color: #fff; }

        /* Task List */
        .task-section-title { font-size: 14px; color: #ccc; margin: 0 0 10px 0; font-weight: 500; }
        .task-list { list-style: none; padding: 0; margin: 0; }
        .task-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; background: #16162a; border-radius: 8px; margin-bottom: 6px; transition: background 0.2s; }
        .task-item:hover { background: #22223a; }
        .task-checkbox { width: 18px; height: 18px; border-radius: 50%; border: 2px solid #555; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 11px; transition: all 0.2s; user-select: none; }
        .task-checkbox.done { background: #22c55e; border-color: #22c55e; color: #fff; }
        .task-title-inner { flex: 1; font-size: 13px; color: #e0e0e0; cursor: pointer; padding: 3px 6px; border-radius: 4px; transition: background 0.15s; }
        .task-title-inner:hover { background: #2a2a3e; }
        .task-title-inner.done { text-decoration: line-through; color: #555; }
        .task-title-edit { flex: 1; background: #0a0a1a; border: 1px solid #4f46e5; border-radius: 4px; color: #e0e0e0; padding: 3px 6px; font-size: 13px; outline: none; }
        .task-meta { display: flex; gap: 6px; align-items: center; }
        .task-priority { font-size: 10px; padding: 2px 7px; border-radius: 4px; background: #222; color: #999; }
        .task-priority.high { background: #7c1d1d; color: #fca5a5; }
        .task-priority.low { background: #1a2e1a; color: #86efac; }
        .task-status-tag { font-size: 10px; padding: 2px 7px; border-radius: 4px; }
        .task-status-tag.in_progress { background: #1e3a5f; color: #60a5fa; }
        .task-status-tag.cancelled { background: #333; color: #666; }
        .inline-select { background: #16162a; border: 1px solid #333; border-radius: 4px; color: #ccc; padding: 1px 4px; font-size: 11px; cursor: pointer; }
        .inline-select:focus { outline: none; border-color: #4f46e5; }

        /* Add Task Row */
        .add-task-row { display: flex; gap: 8px; margin-top: 10px; }
        .add-task-input { flex: 1; background: #16162a; border: 1px solid #333; border-radius: 8px; color: #e0e0e0; padding: 8px 12px; font-size: 13px; }
        .add-task-input:focus { outline: none; border-color: #4f46e5; }
        .priority-select { background: #16162a; border: 1px solid #333; border-radius: 8px; color: #e0e0e0; padding: 8px; font-size: 12px; }

        /* Empty State */
        .empty-state { text-align: center; padding: 36px 20px; color: #555; font-size: 14px; }

        /* List View Cards */
        .list-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
        .list-card { background: #1e1e2e; border-radius: 12px; padding: 16px; cursor: pointer; transition: all 0.2s; border: 1px solid transparent; }
        .list-card:hover { border-color: #4f46e5; background: #22223a; }
        .list-card .card-period { display: block; margin-bottom: 6px; }
        .list-card .card-overview { font-size: 13px; color: #999; margin-bottom: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .list-card .card-stats { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #666; }

        /* Delete goal section */
        .delete-section { margin-top: 10px; padding-top: 10px; border-top: 1px solid #2a2a3e; text-align: right; }

        /* Modal */
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center; }
        .modal-overlay.show { display: flex; }
        .modal-box { background: #1e1e2e; border-radius: 14px; padding: 24px; width: 400px; max-width: 90vw; }
        .modal-box h4 { margin: 0 0 16px 0; font-size: 16px; color: #e0e0e0; }
        .modal-box .form-row { margin-bottom: 12px; }
        .modal-box .form-row label { display: block; font-size: 12px; color: #888; margin-bottom: 4px; }
        .modal-box .form-row input,
        .modal-box .form-row select { width: 100%; background: #16162a; border: 1px solid #333; border-radius: 8px; color: #e0e0e0; padding: 8px 12px; font-size: 13px; }
        .modal-box .form-row input:focus,
        .modal-box .form-row select:focus { outline: none; border-color: #4f46e5; }
        .modal-buttons { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
        .modal-buttons .btn { min-width: 70px; text-align: center; }

        /* Updated at text */
        .update-hint { font-size: 11px; color: #555; line-height: 32px; }

        /* Responsive */
        @media (max-width: 600px) {
            .goal-container { padding: 12px; }
            .goal-tabs { overflow-x: auto; }
            .goal-tab { padding: 8px 14px; font-size: 12px; }
            .period-nav { gap: 6px; }
            .period-btn { padding: 5px 10px; font-size: 11px; }
            .period-label { font-size: 12px; min-width: 120px; }
            .list-grid { grid-template-columns: 1fr; }
            .task-item { flex-wrap: wrap; }
        }
    </style>
</head>
<body>
    <div class="goal-container">
        <div class="goal-header">
            <h2>目标管理</h2>
            <a href="/main" class="back-link">返回首页</a>
        </div>

        <div class="goal-tabs" id="tabs">
            <button class="goal-tab active" data-level="daily">日目标</button>
            <button class="goal-tab" data-level="weekly">周目标</button>
            <button class="goal-tab" data-level="monthly">月目标</button>
            <button class="goal-tab" data-level="yearly">年目标</button>
        </div>

        <div class="period-nav" id="periodNav">
            <button class="period-btn" id="prevBtn">&#9664; 上一期</button>
            <span class="period-label" id="periodLabel">--</span>
            <button class="period-btn" id="nextBtn">下一期 &#9654;</button>
            <button class="period-btn today-btn" id="todayBtn">今天</button>
        </div>

        <div class="view-toggle" id="viewToggle">
            <button class="view-btn active" data-view="detail">详细视图</button>
            <button class="view-btn" data-view="list">列表视图</button>
        </div>

        <div id="mainContent"></div>
    </div>

    <!-- Task Edit Modal -->
    <div class="modal-overlay" id="taskModal">
        <div class="modal-box">
            <h4>编辑任务</h4>
            <div class="form-row">
                <label>任务标题</label>
                <input type="text" id="modalTaskTitle" placeholder="任务标题">
            </div>
            <div class="form-row">
                <label>优先级</label>
                <select id="modalTaskPriority">
                    <option value="low">低优</option>
                    <option value="medium" selected>普通</option>
                    <option value="high">重要</option>
                </select>
            </div>
            <div class="form-row">
                <label>状态</label>
                <select id="modalTaskStatus">
                    <option value="pending">待办</option>
                    <option value="in_progress">进行中</option>
                    <option value="completed">已完成</option>
                    <option value="cancelled">已取消</option>
                </select>
            </div>
            <div class="modal-buttons">
                <button class="btn btn-secondary" onclick="closeTaskModal()">取消</button>
                <button class="btn btn-primary" onclick="saveTaskEdit()">保存</button>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal-overlay" id="confirmModal">
        <div class="modal-box">
            <h4>确认删除</h4>
            <p style="color:#aaa; font-size:13px; margin-bottom:6px;">确定要删除这个目标吗？此操作不可恢复。</p>
            <p style="color:#ef4444; font-size:13px;" id="confirmGoalInfo"></p>
            <div class="modal-buttons">
                <button class="btn btn-secondary" onclick="closeConfirmModal()">取消</button>
                <button class="btn btn-danger" onclick="confirmDeleteGoal()">确认删除</button>
            </div>
        </div>
    </div>

    <script src="/js/goal.js"></script>
</body>
</html>
