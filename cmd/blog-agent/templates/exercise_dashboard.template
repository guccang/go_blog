<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>锻炼 · GUCCANG</title>
    <link rel="stylesheet" href="/css/exercise_dashboard.css?v=3">
</head>
<body>
    <main class="exercise-shell">
        <header class="page-header">
            <a class="brand" href="/main"><span>G</span><strong>锻炼</strong></a>
            <div class="date-tools">
                <a class="professional-link" href="/exercise/pro">专业训练</a>
                <input id="datePicker" type="date" aria-label="记录日期">
                <button id="todayButton" type="button">今天</button>
            </div>
        </header>

        <section class="rhythm-panel" aria-labelledby="rhythmTitle">
            <div class="section-heading">
                <div>
                    <p class="section-kicker">运动脉搏</p>
                    <h1 id="rhythmTitle">保持自己的节奏</h1>
                </div>
                <div class="range-switch" aria-label="统计范围">
                    <button type="button" class="active" data-days="7">近 7 天</button>
                    <button type="button" data-days="30">近 30 天</button>
                </div>
            </div>
            <div class="rhythm-content">
                <div class="metric-list">
                    <article><strong id="exerciseDays">0</strong><span>锻炼天数</span></article>
                    <article><strong id="totalDuration">0</strong><span>总分钟</span></article>
                    <article><strong id="currentStreak">0</strong><span>连续天数</span></article>
                </div>
                <div class="pulse-chart" id="pulseChart" aria-label="每日已完成运动时长"></div>
            </div>
            <p id="rhythmNote" class="rhythm-note">正在读取你的运动节奏…</p>
        </section>

        <div class="work-grid">
            <section class="quick-panel" aria-labelledby="quickTitle">
                <div class="section-heading compact">
                    <div>
                        <p class="section-kicker">快速记录</p>
                        <h2 id="quickTitle">刚刚完成了什么？</h2>
                    </div>
                    <span id="selectedDateLabel" class="selected-date"></span>
                </div>

                <div class="preset-grid" id="presetGrid">
                    <button type="button" data-name="步行" data-type="cardio" data-intensity="low"><span>🚶</span>步行</button>
                    <button type="button" class="active" data-name="慢跑" data-type="cardio" data-intensity="medium"><span>🏃</span>慢跑</button>
                    <button type="button" data-name="力量" data-type="strength" data-intensity="medium"><span>🏋️</span>力量</button>
                    <button type="button" data-name="拉伸" data-type="flexibility" data-intensity="low"><span>🧘</span>拉伸</button>
                    <button type="button" data-name="骑行" data-type="sports" data-intensity="medium"><span>🚴</span>骑行</button>
                    <button type="button" data-custom="true"><span>＋</span>自定义</button>
                </div>

                <div id="customFields" class="custom-fields" hidden>
                    <label>名称<input id="customName" maxlength="30" placeholder="例如：游泳"></label>
                    <label>类型
                        <select id="customType">
                            <option value="cardio">有氧</option>
                            <option value="strength">力量</option>
                            <option value="flexibility">柔韧</option>
                            <option value="sports">运动项目</option>
                            <option value="other">其他</option>
                        </select>
                    </label>
                </div>

                <div class="duration-row">
                    <span>时长</span>
                    <div id="durationChoices" class="duration-choices">
                        <button type="button" data-duration="10">10</button>
                        <button type="button" data-duration="20">20</button>
                        <button type="button" class="active" data-duration="30">30</button>
                        <button type="button" data-duration="45">45</button>
                        <button type="button" data-duration="60">60</button>
                    </div>
                    <small>分钟</small>
                </div>
                <button id="recordButton" class="record-button" type="button">记录完成</button>
            </section>

            <section class="records-panel" aria-labelledby="recordsTitle">
                <div class="section-heading compact">
                    <div>
                        <p class="section-kicker">当天记录</p>
                        <h2 id="recordsTitle">完成过的运动</h2>
                    </div>
                    <strong id="dayTotal" class="day-total">0 分钟</strong>
                </div>
                <div id="exerciseItems" class="exercise-items"></div>
                <div id="exerciseEmpty" class="empty-state" hidden>
                    <span>○</span>
                    <p>这一天还没有记录。</p>
                </div>
            </section>
        </div>
    </main>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <script src="/js/exercise_dashboard.js?v=3"></script>
</body>
</html>
