<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🤖 智能助手 - GUCCANG</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/css/assistant.css">
    <style>
    /* === 重设计覆盖样式 === */
    .status-bar {
        display: flex; align-items: center; gap: 12px; padding: 8px 16px;
        background: rgba(255,255,255,0.03); border-radius: 10px; margin-bottom: 12px;
        border: 1px solid rgba(255,255,255,0.06); flex-wrap: wrap;
    }
    .status-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 12px; border-radius: 20px; font-size: 12px;
        background: rgba(255,255,255,0.06); color: #b0b8c8;
    }
    .status-chip.model { background: linear-gradient(135deg, rgba(0,184,148,0.2), rgba(0,206,201,0.2)); color: #00cec9; }
    .status-chip.tools { background: linear-gradient(135deg, rgba(102,126,234,0.2), rgba(118,75,162,0.2)); color: #a29bfe; }
    .status-chip.router { background: linear-gradient(135deg, rgba(253,203,110,0.2), rgba(225,112,85,0.2)); color: #fdcb6e; }
    .status-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    .welcome-compact { padding: 16px 20px !important; }
    .welcome-compact .message-text { font-size: 14px; }
    .welcome-compact .message-text p { margin: 4px 0; }
    .quick-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .quick-chip {
        padding: 6px 14px; border-radius: 18px; font-size: 12px; cursor: pointer;
        background: rgba(102,126,234,0.15); color: #a29bfe; border: 1px solid rgba(102,126,234,0.3);
        transition: all 0.2s;
    }
    .quick-chip:hover { background: rgba(102,126,234,0.3); transform: translateY(-1px); }

    .tool-count-inline {
        display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px;
        background: rgba(102,126,234,0.15); color: #a29bfe; margin-left: 4px;
    }

    /* 右侧面板精简 */
    .info-panel { max-width: 280px; }
    .info-card { padding: 14px !important; margin-bottom: 10px !important; }
    .info-card h4 { font-size: 13px !important; margin-bottom: 8px !important; }

    /* 移动端适配 */
    @media (max-width: 768px) {
        .info-panel { display: none; }
        .chat-section { max-width: 100% !important; }
        .status-bar { padding: 6px 10px; gap: 6px; }
        .status-chip { font-size: 11px; padding: 3px 8px; }
        .nav-back { flex-wrap: wrap; gap: 4px; }
        .mcp-tools-panel { display: none; }
    }
    @media (min-width: 769px) and (max-width: 1024px) {
        .info-panel { max-width: 220px; }
    }

    /* 工具面板优化 */
    .mcp-tools-panel { margin-top: 8px; }
    .mcp-tools-panel-content { max-height: 300px; overflow-y: auto; }
    </style>
</head>
<body>
    <!-- 返回导航 -->
    <div class="nav-back">
        <a href="/main" class="back-btn">
            <i class="fas fa-home"></i> 返回主页
        </a>
        <a href="/mcp" class="back-btn">
            <i class="fas fa-tools"></i> MCP管理
        </a>
    </div>

    <div class="container">
        <header class="assistant-header">
            <div class="assistant-title">
                <i class="fas fa-robot"></i>
                <h1>智能助手</h1>
                <span class="status-indicator online">在线</span>
            </div>
        </header>

        <!-- 状态栏 -->
        <div class="status-bar" id="statusBar">
            <div class="status-chip model" id="chipModel">
                <span class="dot"></span> <span id="modelName">加载中...</span>
            </div>
            <div class="status-chip tools" id="chipTools">
                🔧 <span id="toolCountText">--</span> 个工具
            </div>
            <div class="status-chip router">
                🧠 智能路由
            </div>
        </div>

        <main class="assistant-main">
            <div id="assistant-content" class="tab-content active">
                <!-- 左侧：聊天界面 -->
                <section class="chat-section">
                <div class="chat-container">
                    <div class="chat-messages" id="chatMessages">
                        <!-- 精简欢迎消息 -->
                        <div class="message assistant-message">
                            <div class="avatar">
                                <i class="fas fa-robot"></i>
                            </div>
                            <div class="message-content welcome-compact" style="position: relative;">
                                <button class="copy-message-btn" onclick="copyMessageToClipboard('你好，我是你的智能助手。支持MCP工具调用，已启用智能路由。', this)">
                                    <i class="fas fa-copy"></i> 复制
                                </button>
                                <div class="message-text">
                                    <p>👋 你好！我是你的智能助手，已配备 <strong>MCP 工具</strong> 和 <strong>智能路由</strong>。</p>
                                    <p>直接问我任何问题，我会自动选择合适的工具来帮你。</p>
                                    <div class="quick-chips">
                                        <span class="quick-chip" onclick="sendQuickMessage('帮我总结今天')">📊 今日总结</span>
                                        <span class="quick-chip" onclick="sendQuickMessage('昨天有什么没完成')">📋 延续待办</span>
                                        <span class="quick-chip" onclick="sendQuickMessage('我的待办和目标对齐吗')">🎯 目标对齐</span>
                                        <span class="quick-chip" onclick="sendQuickMessage('今天练什么')">💪 运动建议</span>
                                        <span class="quick-chip" onclick="sendQuickMessage('阅读建议，下一本读什么')">📚 阅读伴读</span>
                                        <span class="quick-chip" onclick="sendQuickMessage('帮我拆解这个任务：')">🧩 任务拆解</span>
                                        <span class="quick-chip" onclick="sendQuickMessage('我有哪些AI技能')">🔌 技能列表</span>
                                        <span class="quick-chip" onclick="sendQuickMessage('帮我创建一个AI技能')">✨ 创建技能</span>
                                        <span class="quick-chip" onclick="sendQuickMessage('帮我创建一个定时任务')">⏰ 定时任务</span>
                                    </div>
                                    <details class="usage-guide" style="margin-top:12px;font-size:0.85rem;color:rgba(255,255,255,0.8);">
                                        <summary style="cursor:pointer;font-weight:600;color:rgba(255,255,255,0.95);padding:6px 0;">📖 使用指南 — 我能做什么？</summary>
                                        <div style="margin-top:8px;display:grid;gap:10px;">

                                            <div style="background:rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px;">
                                                <div style="font-weight:600;margin-bottom:4px;">🧠 智能分析（AI 自动调用工具）</div>
                                                <div style="opacity:0.85;line-height:1.6;font-size:0.8rem;">
                                                    • "帮我总结今天" → 聚合待办/运动/阅读/目标数据<br>
                                                    • "我的待办和目标对齐吗" → 分析待办与月度目标的匹配度<br>
                                                    • "今天练什么" → 根据近7天运动数据给出训练建议<br>
                                                    • "阅读建议" → 分析阅读进度并推荐下一步阅读<br>
                                                    • "帮我拆解这个任务：XXX" → 将复杂任务拆解为子任务
                                                </div>
                                            </div>

                                            <div style="background:rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px;">
                                                <div style="font-weight:600;margin-bottom:4px;">📋 待办管理</div>
                                                <div style="opacity:0.85;line-height:1.6;font-size:0.8rem;">
                                                    • "今天有哪些待办" / "本周待办完成情况"<br>
                                                    • "添加一个待办：下午3点开会"<br>
                                                    • "昨天有什么没完成的" → 自动延续未完成任务
                                                </div>
                                            </div>

                                            <div style="background:rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px;">
                                                <div style="font-weight:600;margin-bottom:4px;">💪 运动 & 📚 阅读 & 🎯 年度计划</div>
                                                <div style="opacity:0.85;line-height:1.6;font-size:0.8rem;">
                                                    • "我最近的运动记录" / "记录今天跑步30分钟"<br>
                                                    • "我在读什么书" / "更新《XXX》阅读进度到50%"<br>
                                                    • "我的年度目标进度如何" / "添加一个年度目标"
                                                </div>
                                            </div>

                                            <div style="background:rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px;">
                                                <div style="font-weight:600;margin-bottom:4px;">📝 博客 & 🔍 搜索</div>
                                                <div style="opacity:0.85;line-height:1.6;font-size:0.8rem;">
                                                    • "最近写了哪些博客" / "搜索关于XXX的博客"<br>
                                                    • "帮我写一篇关于XXX的博客并保存"<br>
                                                    • "访问网页 https://..." → 抓取并分析网页内容
                                                </div>
                                            </div>

                                            <div style="background:rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px;">
                                                <div style="font-weight:600;margin-bottom:4px;">⏰ 定时任务 & 📊 报告 & 🤖 模型</div>
                                                <div style="opacity:0.85;line-height:1.6;font-size:0.8rem;">
                                                    • "1小时后提醒我喝水" / "每天21点总结今天"<br>
                                                    • "生成本周周报" / "生成月报"<br>
                                                    • "切换到openai模型" / "当前用的什么模型"
                                                </div>
                                            </div>

                                            <div style="background:rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px;">
                                                <div style="font-weight:600;margin-bottom:4px;">✨ AI 技能</div>
                                                <div style="opacity:0.85;line-height:1.6;font-size:0.8rem;">
                                                    • "我有哪些AI技能" → 列出所有已创建的技能卡<br>
                                                    • "帮我创建一个技能：每次我说写周报时自动收集数据生成周报"<br>
                                                    • 技能创建后，下次说"写周报" AI 会自动执行
                                                </div>
                                            </div>

                                        </div>
                                    </details>
                                </div>
                                <div class="message-time">刚刚</div>
                            </div>
                        </div>
                    </div>

                    <div class="chat-input-container">
                        <div class="input-wrapper">
                            <input type="text" id="messageInput" placeholder="问我任何问题，AI 自动选择工具..." maxlength="500">
                            <button class="send-btn" id="sendBtn">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 右侧：精简面板 -->
            <aside class="info-panel">
                <div class="panel-header">
                    <h3><i class="fas fa-chart-line"></i> 数据概览</h3>
                    <button class="refresh-btn" id="refreshData">
                        <i class="fas fa-refresh"></i>
                    </button>
                </div>

                <!-- 今日概览 -->
                <div class="info-card">
                    <h4><i class="fas fa-calendar-day"></i> 今日概览</h4>
                    <div class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-value" id="todayTasks">-</div>
                            <div class="stat-label">任务完成</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value" id="todayReading">-</div>
                            <div class="stat-label">阅读进度</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value" id="todayExercise">-</div>
                            <div class="stat-label">锻炼记录</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value" id="todayBlogs">-</div>
                            <div class="stat-label">博客写作</div>
                        </div>
                    </div>
                </div>

                <!-- 聊天历史 -->
                <div class="info-card">
                    <h4><i class="fas fa-history"></i> 聊天历史</h4>
                    <div class="chat-history-controls">
                        <input type="date" id="chatHistoryDate" class="date-input" title="选择日期查看聊天历史">
                        <button class="load-history-btn" id="loadHistoryBtn" onclick="loadSelectedDateHistory()">
                            <i class="fas fa-search"></i> 加载
                        </button>
                    </div>
                    <div class="history-info">
                        <small>选择日期查看对应的聊天记录</small>
                    </div>
                </div>

                <!-- 趋势图表 -->
                <div class="info-card">
                    <h4><i class="fas fa-chart-area"></i> 近期趋势</h4>
                    <div class="chart-container">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>
            </aside>
            </div>
        </main>

        <!-- MCP工具管理面板（精简版） -->
        <section class="mcp-tools-panel">
            <div class="mcp-tools-panel-header">
                <h3><i class="fas fa-tools"></i> MCP 工具 <span id="toolCountBadge2" class="tool-count-inline">--</span></h3>
                <div class="mcp-tools-panel-actions">
                    <button class="mcp-panel-toggle" onclick="toggleMCPPanel()">
                        <i class="fas fa-chevron-up"></i>
                    </button>
                </div>
            </div>
            <div class="mcp-tools-panel-content" id="mcp-tools-panel-content">
                <div id="mcp-tools-status-large" class="mcp-tools-status-large">
                    <div class="mcp-status-loading">
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>正在加载MCP工具...</span>
                    </div>
                </div>
                <div class="mcp-info-large">
                    <div class="mcp-info-grid">
                        <div class="mcp-info-item">
                            <i class="fas fa-info-circle"></i>
                            <div>
                                <strong>智能工具路由</strong>
                                <p>已启用智能路由，AI 自动从全部工具中筛选相关工具，无需手动选择。</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 设置面板 -->
        <div class="settings-panel" id="settingsPanel">
            <div class="settings-header">
                <h3><i class="fas fa-cog"></i> 助手设置</h3>
                <button class="close-btn" id="closeSettings">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="settings-content">
                <div class="setting-group">
                    <h4>显示效果</h4>
                    <div class="setting-item">
                        <label class="switch">
                            <input type="checkbox" id="enableTypingEffect" checked>
                            <span class="slider"></span>
                        </label>
                        <span>启用打字机光标效果</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 设置按钮 -->
        <button class="settings-btn" id="settingsBtn">
            <i class="fas fa-cog"></i>
        </button>
    </div>

    <script src="/js/marked/marked.min.js"></script>
    <script src="/js/assistant.js"></script>
    <script>
    // 快捷消息发送
    function sendQuickMessage(text) {
        const input = document.getElementById('messageInput');
        if (input) {
            input.value = text;
            document.getElementById('sendBtn').click();
        }
    }

    // MCP面板切换
    function toggleMCPPanel() {
        const content = document.getElementById('mcp-tools-panel-content');
        const toggle = document.querySelector('.mcp-panel-toggle i');
        if (content) {
            const isHidden = content.style.display === 'none';
            content.style.display = isHidden ? 'block' : 'none';
            if (toggle) toggle.className = isHidden ? 'fas fa-chevron-up' : 'fas fa-chevron-down';
        }
    }

    // 显示MCP工具对话框（滚动到工具面板）
    function showMCPToolsDialog() {
        const panel = document.querySelector('.mcp-tools-panel');
        if (panel) {
            const content = document.getElementById('mcp-tools-panel-content');
            if (content) content.style.display = 'block';
            panel.scrollIntoView({ behavior: 'smooth' });
        }
    }

    // 页面加载时获取工具数量和模型信息
    (function() {
        fetch('/api/mcp/tools')
            .then(r => r.json())
            .then(data => {
                const count = data.data ? data.data.length : 0;
                const el = document.getElementById('toolCountText');
                const el2 = document.getElementById('toolCountBadge2');
                if (el) el.textContent = count;
                if (el2) el2.textContent = count + ' 个';
            })
            .catch(() => {
                const el = document.getElementById('toolCountText');
                if (el) el.textContent = '离线';
            });

        // 设置日期选择器默认为今天
        const dateInput = document.getElementById('chatHistoryDate');
        if (dateInput) {
            dateInput.value = new Date().toISOString().split('T')[0];
        }

        // 自动加载今天的聊天历史
        loadChatHistoryForDate(new Date().toISOString().split('T')[0]);
    })();

    // 加载指定日期的聊天历史
    function loadChatHistoryForDate(date) {
        fetch('/api/assistant/chat/history?date=' + date)
            .then(r => r.json())
            .then(data => {
                if (data.success && data.chatHistory && data.chatHistory.length > 0) {
                    const container = document.getElementById('chatMessages');
                    // 保留欢迎消息（第一个子元素）
                    const welcome = container.firstElementChild;

                    // 清除旧的历史消息（保留欢迎）
                    while (container.children.length > 1) {
                        container.removeChild(container.lastChild);
                    }

                    // 添加历史分隔线
                    const sep = document.createElement('div');
                    sep.className = 'message assistant-message';
                    sep.innerHTML = '<div class="avatar"><i class="fas fa-history"></i></div>' +
                        '<div class="message-content" style="padding:8px 14px;font-size:12px;color:#888;">' +
                        '📜 以下是 ' + date + ' 的聊天记录（' + data.chatHistory.length + ' 条）</div>';
                    container.appendChild(sep);

                    // 插入历史消息
                    data.chatHistory.forEach(msg => {
                        const div = document.createElement('div');
                        const isUser = msg.role === 'user';
                        div.className = 'message ' + (isUser ? 'user-message' : 'assistant-message');

                        const avatarIcon = isUser ? 'fa-user' : 'fa-robot';
                        const content = msg.content || '';
                        // 尝试用 marked 渲染 markdown
                        let rendered = content;
                        if (typeof marked !== 'undefined' && !isUser) {
                            try { rendered = marked.parse(content); } catch(e) { rendered = content; }
                        }

                        div.innerHTML = '<div class="avatar"><i class="fas ' + avatarIcon + '"></i></div>' +
                            '<div class="message-content"><div class="message-text">' + rendered + '</div>' +
                            (msg.timestamp ? '<div class="message-time">' + msg.timestamp + '</div>' : '') +
                            '</div>';
                        container.appendChild(div);
                    });

                    // 滚动到底部
                    container.scrollTop = container.scrollHeight;
                }
            })
            .catch(err => console.log('加载历史失败:', err));
    }

    // 手动加载选定日期的历史
    function loadSelectedDateHistory() {
        const dateInput = document.getElementById('chatHistoryDate');
        if (dateInput && dateInput.value) {
            loadChatHistoryForDate(dateInput.value);
        }
    }
    </script>

</body>
</html>