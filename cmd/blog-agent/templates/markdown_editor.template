<!DOCTYPE html>
<html lang="zh-CN" data-page="markdown-editor">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>写博客 · GUCCANG</title>
    <script src="/js/theme.js?v=6"></script>
    <link rel="stylesheet" href="/css/theme.css?v=6">
    <link rel="stylesheet" href="/css/markdown_editor.css?v=workspace-1">
    <link rel="stylesheet" href="/css/editor_workspace.css?v=1">
    <link rel="stylesheet" href="/css/editor_workspace_unified.css?v=1">
</head>
<body class="workspace-page">
    <main class="writing-shell site-shell">
        <header class="writing-header site-hanging-nav">
            <a class="brand-back" href="/main"><span>G</span> 内容工作台</a>
            <div class="header-actions">
                <a class="quiet-action" href="/image-paste-demo">试用图片粘贴</a>
                <button class="save-action" id="btn-save" type="button" onclick="submitContent()">保存博客</button>
            </div>
        </header>

        <section class="article-meta site-page-hero">
            <div class="site-page-hero__copy"><p class="section-kicker site-kicker">新建博客</p><input id="title" name="title" value="{{.TITLE}}" placeholder="给这篇内容起个标题" aria-label="博客标题"><input id="tags" name="tags" value="{{.TAGS}}" placeholder="添加标签，用 | 分隔" aria-label="博客标签"></div>
            <div class="site-page-hero__exhibit" aria-hidden="true"><span class="site-page-symbol" data-symbol="editor"></span></div>
        </section>

        <details class="access-panel site-paper-panel">
            <summary><span>访问设置</span><small>私有、公开、日记和加密</small></summary>
            <div class="access-grid">
                <fieldset>
                    <legend>可见范围</legend>
                    <label class="choice"><input type="radio" name="base_auth_type" value="private" {{if .IS_PRIVATE}}checked{{end}}><span>私有</span><small>登录后可见</small></label>
                    <label class="choice"><input type="radio" name="base_auth_type" value="public" {{if .IS_PUBLIC}}checked{{end}}><span>公开</span><small>任何人可访问</small></label>
                </fieldset>
                <fieldset>
                    <legend>额外保护</legend>
                    <label class="choice"><input id="diary_permission" type="checkbox" name="diary_permission" {{if .IS_DIARY}}checked{{end}}><span>日记验证</span><small>访问时需要日记密码</small></label>
                    <label class="choice"><input id="encrypt_permission" type="checkbox" name="encrypt_permission" {{if .IS_ENCRYPTED}}checked{{end}}><span>内容加密</span><small>正文将以 AES 保存</small></label>
                </fieldset>
                <div class="password-field" id="encrypt-section">
                    <label for="encrypt" id="encrypt-label">加密密码</label>
                    <input id="encrypt" type="password" name="encrypt" value="{{.ENCRYPT}}" placeholder="启用加密后填写">
                    <small id="encrypt-hint">启用内容加密时必须设置密码</small>
                </div>
            </div>
        </details>

        <nav class="writing-toolbar site-paper-panel" aria-label="Markdown 工具栏">
            <div class="format-tools">
                <button id="btn-bold" type="button" title="粗体"><b>B</b></button>
                <button id="btn-italic" type="button" title="斜体"><i>I</i></button>
                <button id="btn-heading" type="button" title="标题">H</button>
                <button id="btn-link" type="button" title="链接">链接</button>
                <button id="btn-image" type="button" title="插入网络图片地址">图片链接</button>
                <button id="btn-upload-image" class="upload-image-action" type="button" title="上传图片或小文件">上传文件</button>
                <input id="image-file-input" type="file" accept="image/*,.txt,.md,.html,.htm,.csv,.json,.xml,.yaml,.yml,.zip,.pdf" multiple hidden>
                <button id="btn-code" type="button" title="代码块">&lt;/&gt;</button>
                <button id="btn-list" type="button" title="列表">列表</button>
                <button id="btn-quote" type="button" title="引用">引用</button>
            </div>
            <div class="view-switcher" id="view-switcher" aria-label="显示模式">
                <button class="view-mode-btn" data-view="editor-only" type="button">编辑</button>
                <button class="view-mode-btn active" data-view="split" type="button">双栏</button>
                <button class="view-mode-btn" data-view="preview-only" type="button">预览</button>
            </div>
        </nav>

        <section class="editor-content site-paper-panel" id="editor-content">
            <div class="editor-wrapper" id="editor-wrapper">
                <div class="pane-title"><span class="pane-dot"></span> Markdown <span id="word-count"></span></div>
                <textarea class="editor" id="editor" name="content" spellcheck="false" aria-label="博客正文">{{.CONTENT}}</textarea>
                <p class="paste-hint">支持图片、TXT、Markdown、HTML、CSV、JSON、XML、YAML、ZIP、PDF（最大 10MB）；也可粘贴截图或拖入文件，上传后会自动插入 Markdown。</p>
            </div>
            <div class="preview-wrapper" id="preview-wrapper">
                <div class="pane-title">阅读预览 <span class="preview-badge">实时</span></div>
                <div class="mdEditor" id="md"></div>
            </div>
        </section>
    </main>
    <div class="toast-container" id="toast-container"></div>
    <script src="/js/crypto/crypto-js.min.js"></script>
    <script src="/js/marked/marked.min.js"></script>
    <script src="/js/editor.js"></script>
    <script src="/js/permissions.js"></script>
    <script src="/js/markdown_editor.js?v=workspace-1"></script>
    <script src="/js/image_upload.js?v=2"></script>
</body>
</html>
