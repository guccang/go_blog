<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>问 PI - GUCCANG</title>
    <link rel="stylesheet" href="/css/query_page.css?v=continue-1">
    <script src="/js/theme.js?v=1"></script>
    <link rel="stylesheet" href="/css/theme.css?v=1">
</head>
<body>
    <header class="query-header">
        <a class="query-brand" href="/main"><span>G</span><strong>问 PI</strong></a>
        <nav><a href="/link">BLOG</a><a class="query-account" href="/account">{{.USER_AVATAR}}</a></nav>
    </header>
    <main id="askPage" class="query-shell" data-query="{{.QUERY}}" data-account="{{.USER_ACCOUNT}}">
        <a class="back-link" href="/main">← 返回主页</a>
        <h1>问我的博客</h1>
        <p class="page-description">PI 会先简要回答，再结合站内资料总结并给出下一步建议。</p>
        <form id="askPageForm" class="standalone-query">
            <input id="askPageInput" type="search" maxlength="120" value="{{.QUERY}}"
                   placeholder="输入一个想从博客中寻找答案的问题" autocomplete="off">
            <button type="submit">生成回答</button>
        </form>
        <div class="answer-toolbar">
            <p id="askStatus" class="query-status" aria-live="polite"></p>
            <button id="regenerateAnswer" class="text-button" type="button" hidden>重新生成</button>
        </div>
        <section id="piAnswer" class="pi-answer" hidden>
            <article id="piBrief" class="answer-block"></article>
            <article id="piSummary" class="answer-block"></article>
            <article id="piAdvice" class="answer-block"></article>
            <div id="piSources" class="answer-sources"></div>
            <p id="piUsage" class="answer-usage"></p>
        </section>
    </main>
    <script src="/js/ask.js?v=continue-1"></script>
</body>
</html>
