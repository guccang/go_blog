<!DOCTYPE html>
<html lang="zh-CN" data-page="ask">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>问 PI - GUCCANG</title>
    <script src="/js/theme.js?v=6"></script>
    <link rel="stylesheet" href="/css/theme.css?v=6">
    <link rel="stylesheet" href="/css/query_page.css?v=unified-2">
</head>
<body>
    <header class="query-header site-shell site-hanging-nav">
        <a class="query-brand" href="/main"><span>G</span><strong>问 PI</strong></a>
        <nav><a href="/link">BLOG</a><a class="query-account" href="/account">{{.USER_AVATAR}}</a></nav>
    </header>
    <main id="askPage" class="query-shell site-shell" data-query="{{.QUERY}}" data-account="{{.USER_ACCOUNT}}">
        <section class="site-page-hero" aria-labelledby="askPageTitle">
            <div class="site-page-hero__copy">
                <a class="back-link" href="/main">← 返回主页</a>
                <p class="site-kicker">PI · KNOWLEDGE DIALOGUE</p>
                <h1 id="askPageTitle" class="site-page-title">问我的博客</h1>
                <p class="site-page-description">PI 会先简要回答，再结合站内资料总结并给出下一步建议。</p>
            </div>
            <div class="site-page-hero__exhibit" aria-hidden="true">
                <span class="site-page-symbol" data-symbol="editor"></span>
            </div>
        </section>
        <section class="query-workspace site-section" aria-label="PI 问答工作台">
            <form id="askPageForm" class="standalone-query site-paper-panel">
                <input id="askPageInput" type="search" maxlength="120" value="{{.QUERY}}"
                       placeholder="输入一个想从博客中寻找答案的问题" autocomplete="off">
                <button class="site-ticket" type="submit">生成回答</button>
            </form>
            <div class="answer-toolbar">
                <p id="askStatus" class="query-status" aria-live="polite"></p>
                <button id="regenerateAnswer" class="text-button site-ticket" type="button" hidden>重新生成</button>
            </div>
            <section id="piAnswer" class="pi-answer site-paper-panel" hidden>
                <article id="piBrief" class="answer-block"></article>
                <article id="piSummary" class="answer-block"></article>
                <article id="piAdvice" class="answer-block"></article>
                <div id="piSources" class="answer-sources"></div>
                <p id="piUsage" class="answer-usage"></p>
            </section>
        </section>
    </main>
    <script src="/js/ask.js?v=continue-1"></script>
</body>
</html>
