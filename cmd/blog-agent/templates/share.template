<!DOCTYPE html>

<html lang="zh-CN" data-page="share">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>共享博客 - GUCCANG</title>
	    <script src="/js/theme.js?v=7"></script>
    <link rel="stylesheet" href="/css/theme.css?v=7">
    <link rel="stylesheet" href="/css/share.css?v=unified-1">
</head>

	<body>
		<header class="site-shell site-hanging-nav">
			<a href="/main">GUCCANG</a>
			<nav><a href="/editor">创建博客</a></nav>
		</header>
		<main class="site-shell">
			<section class="site-page-hero" aria-labelledby="sharePageTitle">
				<div class="site-page-hero__copy">
					<p class="site-kicker">SHARED · COLLECTION</p>
					<h1 id="sharePageTitle" class="site-page-title">共享博客</h1>
					<p class="site-page-description">浏览对外开放的记录，或按标签快速定位。</p>
				</div>
				<div class="site-page-hero__exhibit" aria-hidden="true">
					<span class="site-page-symbol" data-symbol="portal"></span>
				</div>
			</section>

			<section class="share-search site-section" aria-label="共享博客检索">
				<div class="share-search__panel site-paper-panel">
					<label for="search">按标签检索</label>
					<input id="search" type="text" list="search_list" placeholder="输入标签后按 Enter">
					<datalist id="search_list">
						{{range .TAGS}}
						<option>{{.Name}}</option>
						{{end}}
					</datalist>
				</div>
			</section>

			<section class="site-section" aria-label="共享文章列表">
				<div class="site-index-list site-paper-panel">
					{{range .LINKS}}
					<p><a href="{{.URL}}">{{.DESC}}</a></p>
					{{end}}
				</div>
			</section>
		</main>

		<footer class="share-footer site-shell">
			<span>{{.BLOGS_NUMBER}}</span>
			<span>{{.VERSION}}</span>
		</footer>

		<script src="/js/utils.js"></script>
		<script>

		PageHistoryBack()

		document.addEventListener('keydown', function(event) {
			console.log(`key=${event.key},code=${event.code}`);
			if (event.key === "Enter") {
				event.preventDefault();
				onSearch()
			}
		});


		</script>

	</body>
</html>
