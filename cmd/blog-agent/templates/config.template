<!DOCTYPE html>
<html lang="zh-CN" data-page="config">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
    <script src="/js/theme.js?v=5"></script>
    <link rel="stylesheet" href="/css/theme.css?v=5">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/config.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/config_unified.css?v=1">
</head>
<body>
    <div class="container site-shell">
        <header class="header site-page-hero">
            <div class="site-page-hero__copy">
                <p class="site-kicker">SYSTEM · SETTINGS</p>
                <h1 class="site-page-title">系统配置</h1>
                <p class="header-subtitle site-page-description">仅展示日常运行所需的核心参数</p>
            </div>
            <div class="site-page-hero__exhibit" aria-hidden="true"><span class="site-page-symbol" data-symbol="settings"></span></div>
            <div class="header-actions">
                <button class="btn btn-secondary" onclick="goBack()">返回</button>
                <button class="btn btn-success" onclick="saveAllConfigs()">保存配置</button>
            </div>
        </header>

        <div class="content site-section">
            <div class="config-notice site-paper-panel">
                <span>修改后点击“保存配置”生效；端口与 PI Agent Provider 配置需重启服务。</span>
            </div>

            <!-- 配置列表 -->
            <div class="config-list" id="configList">
                <!-- 配置项将通过JavaScript动态加载 -->
            </div>

        </div>
    </div>

    <!-- Toast 提示 -->
    <div id="toast" class="toast"></div>

    <!-- 智能助手悬浮图标 -->
    <a href="/assistant" class="assistant-floating-btn" title="智能助手">
        <i class="fas fa-robot"></i>
    </a>

    <script src="/js/move_assistant.js"></script>
    <script src="/js/config.js?v=pi-agent-json-2"></script>
</body>
</html>
