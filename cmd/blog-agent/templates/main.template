<!DOCTYPE html>
<html lang="zh-CN" data-page="main">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GUCCANG</title>
    <script src="/js/theme.js?v=8"></script>
    <link rel="stylesheet" href="/css/theme.css?v=9">
    <link rel="stylesheet" href="/css/main.css?v=dunhuang-3">
</head>
<body>
    <header class="main-header site-shell site-hanging-nav">
        <a class="brand" href="/main" aria-label="GUCCANG 主页"><span>G</span><strong>GUCCANG</strong></a>
        <nav class="main-nav" aria-label="主页导航">
            <a href="/link">BLOG</a>
            <div class="more-menu">
                <button id="moreMenuButton" type="button" aria-expanded="false" aria-controls="moreMenu">更多</button>
                <div id="moreMenu" class="more-panel" hidden>
                    <a href="/tools">实用工具</a>
                    <a href="/insights">使用洞察</a>
                    <a href="/public?account={{.USER_ACCOUNT}}">公开博客</a>
                    <a href="/config">系统配置</a>
                </div>
            </div>
            <a class="account-link" href="/account" aria-label="账户 {{.USER_ACCOUNT}}">{{.USER_AVATAR}}</a>
        </nav>
    </header>

    <main class="main-shell site-shell">
        <section class="query-hero site-page-hero" aria-labelledby="mainTitle">
            <div class="main-celadon-stage" id="celadonStage" data-render-state="loading"
                 data-celadon-mode="ambient"
                 data-celadon-asset="/images/visual-symbols/visual-symbols-01.webp"
                 aria-hidden="true">
                <canvas id="celadonCanvas"></canvas>
                <div class="stage-status">
                    <strong id="stageStatusTitle">正在初始化青瓷雨</strong>
                    <small id="stageStatusDetail">准备风场、水面与柔和光场。</small>
                </div>
            </div>
            <div class="main-dunhuang-stage" id="dunhuangStage" data-render-state="loading"
                 data-dunhuang-mode="ambient"
                 data-dunhuang-asset="/images/visual-symbols/visual-symbols-01.webp"
                 aria-hidden="true">
                <canvas id="dunhuangCanvas"></canvas>
                <div class="stage-status">
                    <strong data-dunhuang-status-title>正在初始化敦煌暮色</strong>
                    <small data-dunhuang-status-detail>准备飘带、矿物尘与暮色光场。</small>
                </div>
            </div>
            <div class="site-page-hero__copy">
                <p class="eyebrow site-kicker">PERSONAL KNOWLEDGE PORTAL</p>
                <h1 id="mainTitle" class="site-page-title">今天想继续什么？</h1>
                <p class="site-page-description">从一条搜索、一篇记录或一个正在推进的目标开始，让知识沿着今天继续生长。</p>
                <form id="workspaceQueryForm" class="query-form site-paper-panel">
                    <label class="sr-only" for="workspaceQuery">搜索博客或向 PI 提问</label>
                    <input id="workspaceQuery" type="search" maxlength="120" autocomplete="off"
                           placeholder="搜索博客，或输入一个想问 PI 的问题">
                    <div class="query-actions">
                        <button class="search-button site-ticket" type="submit">搜索博客</button>
                        <button class="pi-button site-ticket" id="askPIButton" type="button">问 PI</button>
                    </div>
                </form>
                <p id="queryHint" class="query-hint" aria-live="polite">按 Enter 默认搜索本地博客。</p>
            </div>
            <div class="site-page-hero__exhibit" aria-hidden="true">
                <span class="site-page-symbol" data-symbol="portal" data-symbol-motion="portal"></span>
            </div>
            <details class="main-celadon-controls" id="mainCeladonControls">
                <summary><span><i class="main-celadon-controls__compact-label">调景</i><i class="main-celadon-controls__full-label">雨景参数</i></span><small>AMBIENCE</small></summary>
                <div class="main-celadon-controls__body">
                    <fieldset>
                        <legend>风雨</legend>
                        <label for="mainCeladonWindDirection"><span>风向</span>
                            <select id="mainCeladonWindDirection" data-celadon-wind-direction>
                                <option value="north">北风 N → S</option><option value="northeast">东北风 NE → SW</option>
                                <option value="east">东风 E → W</option><option value="southeast">东南风 SE → NW</option>
                                <option value="south">南风 S → N</option><option value="southwest">西南风 SW → NE</option>
                                <option value="west" selected>西风 W → E</option><option value="northwest">西北风 NW → SE</option>
                            </select>
                        </label>
                        <label for="mainCeladonWind"><span>风力</span><output data-celadon-output="wind">1.00</output></label>
                        <input id="mainCeladonWind" data-celadon-setting="wind" data-celadon-format="fixed2" type="range" min="0" max="2" value="1" step="0.05">
                        <label for="mainCeladonRain"><span>雨量</span><output data-celadon-output="rain">1.00</output></label>
                        <input id="mainCeladonRain" data-celadon-setting="rain" data-celadon-format="fixed2" type="range" min="0.15" max="1.8" value="1" step="0.05">
                    </fieldset>

                    <fieldset>
                        <legend>光场</legend>
                        <label for="mainCeladonLight"><span>环境光</span><output data-celadon-output="light">1.00</output></label>
                        <input id="mainCeladonLight" data-celadon-setting="light" data-celadon-format="fixed2" type="range" min="0.45" max="1.35" value="1" step="0.05">
                        <label><span>光源形态</span><output data-celadon-light-source-output>点光源</output></label>
                        <div class="main-celadon-source-picker" role="group" aria-label="选择光源形态">
                            <button type="button" data-celadon-light-source="point" aria-pressed="true">点光</button>
                            <button type="button" data-celadon-light-source="spot" aria-pressed="false">聚光</button>
                            <button type="button" data-celadon-light-source="directional" aria-pressed="false">平行</button>
                            <button type="button" data-celadon-light-source="area" aria-pressed="false">面光</button>
                        </div>
                        <label for="mainCeladonSourceIntensity"><span>光源强度</span><output data-celadon-output="sourceIntensity">0.72</output></label>
                        <input id="mainCeladonSourceIntensity" data-celadon-setting="sourceIntensity" data-celadon-format="fixed2" type="range" min="0.15" max="1.25" value="0.72" step="0.01">
                        <label for="mainCeladonLightPosition"><span>水平位置</span><output data-celadon-output="lightPosition">68%</output></label>
                        <input id="mainCeladonLightPosition" data-celadon-setting="lightPosition" data-celadon-format="percent" type="range" min="0.12" max="0.88" value="0.68" step="0.01">
                        <label for="mainCeladonLightVertical"><span>垂直位置</span><output data-celadon-output="lightVertical">84%</output></label>
                        <input id="mainCeladonLightVertical" data-celadon-setting="lightVertical" data-celadon-format="percent" type="range" min="0.38" max="0.96" value="0.84" step="0.01">
                        <label for="mainCeladonLightAngle"><span>入射方向</span><output data-celadon-output="lightAngle">右上 28°</output></label>
                        <input id="mainCeladonLightAngle" data-celadon-setting="lightAngle" data-celadon-format="angle" type="range" min="-60" max="60" value="-28" step="1">
                        <label for="mainCeladonLightRange"><span>作用范围</span><output data-celadon-output="lightRange">0.62</output></label>
                        <input id="mainCeladonLightRange" data-celadon-setting="lightRange" data-celadon-format="fixed2" type="range" min="0.25" max="1.2" value="0.62" step="0.01">
                    </fieldset>

                    <fieldset>
                        <legend>呼吸与散射</legend>
                        <label class="main-celadon-switch"><span>呼吸光</span><input type="checkbox" data-celadon-toggle="breathingEnabled" checked></label>
                        <label for="mainCeladonBreathStrength"><span>呼吸幅度</span><output data-celadon-output="breathStrength">0.28</output></label>
                        <input id="mainCeladonBreathStrength" data-celadon-setting="breathStrength" data-celadon-format="fixed2" type="range" min="0" max="0.65" value="0.28" step="0.01">
                        <label for="mainCeladonBreathPeriod"><span>呼吸周期</span><output data-celadon-output="breathPeriod">6.5 s</output></label>
                        <input id="mainCeladonBreathPeriod" data-celadon-setting="breathPeriod" data-celadon-format="seconds" type="range" min="3" max="16" value="6.5" step="0.5">
                        <label class="main-celadon-switch"><span>丁达尔</span><input type="checkbox" data-celadon-toggle="tyndallEnabled" checked></label>
                        <label for="mainCeladonTyndall"><span>散射强度</span><output data-celadon-output="tyndallStrength">0.75</output></label>
                        <input id="mainCeladonTyndall" data-celadon-setting="tyndallStrength" data-celadon-format="fixed2" type="range" min="0" max="1.5" value="0.75" step="0.05">
                        <label for="mainCeladonMedium"><span>介质密度</span><output data-celadon-output="mediumDensity">0.72</output></label>
                        <input id="mainCeladonMedium" data-celadon-setting="mediumDensity" data-celadon-format="fixed2" type="range" min="0.15" max="1.25" value="0.72" step="0.01">
                    </fieldset>

                    <fieldset>
                        <legend>光束簇</legend>
                        <label class="main-celadon-switch"><span>多束光</span><input type="checkbox" data-celadon-toggle="beamEnabled" checked></label>
                        <label for="mainCeladonBeamCount"><span>数量</span><output data-celadon-output="beamCount">5 束</output></label>
                        <input id="mainCeladonBeamCount" data-celadon-setting="beamCount" data-celadon-format="beams" type="range" min="1" max="7" value="5" step="1">
                        <label for="mainCeladonBeamSpread"><span>展开范围</span><output data-celadon-output="beamSpread">0.32</output></label>
                        <input id="mainCeladonBeamSpread" data-celadon-setting="beamSpread" data-celadon-format="fixed2" type="range" min="0.08" max="0.58" value="0.32" step="0.01">
                        <label for="mainCeladonBeamSoftness"><span>边缘柔和</span><output data-celadon-output="beamSoftness">0.52</output></label>
                        <input id="mainCeladonBeamSoftness" data-celadon-setting="beamSoftness" data-celadon-format="fixed2" type="range" min="0.12" max="0.88" value="0.52" step="0.01">
                    </fieldset>

                    <div class="main-celadon-actions">
                        <button type="button" data-celadon-action="impact">单次落滴</button>
                        <button type="button" data-celadon-action="pause" aria-pressed="false">暂停</button>
                        <button type="button" data-celadon-action="reset">重置</button>
                    </div>
                </div>
            </details>
            <details class="main-dunhuang-controls" id="mainDunhuangControls">
                <summary><span><i class="main-dunhuang-controls__compact-label">调景</i><i class="main-dunhuang-controls__full-label">暮色参数</i></span><small>AMBIENCE</small></summary>
                <div class="main-dunhuang-controls__body">
                    <fieldset>
                        <legend>风沙</legend>
                        <label for="mainDunhuangWindDirection"><span>风向</span>
                            <select id="mainDunhuangWindDirection" data-dunhuang-wind-direction>
                                <option value="north">北风 N → S</option><option value="northeast">东北风 NE → SW</option>
                                <option value="east">东风 E → W</option><option value="southeast">东南风 SE → NW</option>
                                <option value="south">南风 S → N</option><option value="southwest">西南风 SW → NE</option>
                                <option value="west" selected>西风 W → E</option><option value="northwest">西北风 NW → SE</option>
                            </select>
                        </label>
                        <label for="mainDunhuangWind"><span>风场强度</span><output data-dunhuang-output="windStrength">0.90</output></label>
                        <input id="mainDunhuangWind" data-dunhuang-setting="windStrength" data-dunhuang-format="fixed2" type="range" min="0" max="2" value="0.9" step="0.05">
                        <label for="mainDunhuangDust"><span>沙尘密度</span><output data-dunhuang-output="dustDensity">0.72</output></label>
                        <input id="mainDunhuangDust" data-dunhuang-setting="dustDensity" data-dunhuang-format="fixed2" type="range" min="0.1" max="1.4" value="0.72" step="0.02">
                    </fieldset>

                    <fieldset>
                        <legend>飘带动力</legend>
                        <label for="mainDunhuangRibbonAmplitude"><span>飘带摆幅</span><output data-dunhuang-output="ribbonAmplitude">0.72</output></label>
                        <input id="mainDunhuangRibbonAmplitude" data-dunhuang-setting="ribbonAmplitude" data-dunhuang-format="fixed2" type="range" min="0" max="1.4" value="0.72" step="0.02">
                        <label for="mainDunhuangRibbonTension"><span>织物张力</span><output data-dunhuang-output="ribbonTension">0.58</output></label>
                        <input id="mainDunhuangRibbonTension" data-dunhuang-setting="ribbonTension" data-dunhuang-format="fixed2" type="range" min="0.08" max="0.95" value="0.58" step="0.01">
                        <label for="mainDunhuangRibbonResponse"><span>风场响应</span><output data-dunhuang-output="ribbonResponse">0.80</output></label>
                        <input id="mainDunhuangRibbonResponse" data-dunhuang-setting="ribbonResponse" data-dunhuang-format="fixed2" type="range" min="0.1" max="1.3" value="0.8" step="0.02">
                    </fieldset>

                    <fieldset>
                        <legend>暮色光场</legend>
                        <label for="mainDunhuangLight"><span>月轮光强</span><output data-dunhuang-output="lightStrength">0.78</output></label>
                        <input id="mainDunhuangLight" data-dunhuang-setting="lightStrength" data-dunhuang-format="fixed2" type="range" min="0.15" max="1.3" value="0.78" step="0.01">
                        <label><span>光源形态</span><output data-dunhuang-light-source-output>聚光源</output></label>
                        <div class="main-dunhuang-source-picker" role="group" aria-label="选择敦煌暮色光源形态">
                            <button type="button" data-dunhuang-light-source="point" aria-pressed="false">点光</button>
                            <button type="button" data-dunhuang-light-source="spot" aria-pressed="true">聚光</button>
                            <button type="button" data-dunhuang-light-source="directional" aria-pressed="false">平行</button>
                            <button type="button" data-dunhuang-light-source="area" aria-pressed="false">面光</button>
                        </div>
                        <label for="mainDunhuangLightX"><span>水平位置</span><output data-dunhuang-output="lightX">34%</output></label>
                        <input id="mainDunhuangLightX" data-dunhuang-setting="lightX" data-dunhuang-format="percent" type="range" min="0.12" max="0.88" value="0.34" step="0.01">
                        <label for="mainDunhuangLightY"><span>垂直位置</span><output data-dunhuang-output="lightY">72%</output></label>
                        <input id="mainDunhuangLightY" data-dunhuang-setting="lightY" data-dunhuang-format="percent" type="range" min="0.3" max="0.94" value="0.72" step="0.01">
                        <label for="mainDunhuangLightAngle"><span>入射角度</span><output data-dunhuang-output="lightAngle">右倾 20°</output></label>
                        <input id="mainDunhuangLightAngle" data-dunhuang-setting="lightAngle" data-dunhuang-format="angle" type="range" min="-60" max="60" value="20" step="1">
                    </fieldset>

                    <fieldset>
                        <legend>呼吸与散射</legend>
                        <label class="main-dunhuang-switch"><span>呼吸月光</span><input type="checkbox" data-dunhuang-toggle="breathingEnabled" checked></label>
                        <label for="mainDunhuangBreathStrength"><span>呼吸幅度</span><output data-dunhuang-output="breathStrength">0.24</output></label>
                        <input id="mainDunhuangBreathStrength" data-dunhuang-setting="breathStrength" data-dunhuang-format="fixed2" type="range" min="0" max="0.6" value="0.24" step="0.01">
                        <label for="mainDunhuangBreathPeriod"><span>呼吸周期</span><output data-dunhuang-output="breathPeriod">7.0 s</output></label>
                        <input id="mainDunhuangBreathPeriod" data-dunhuang-setting="breathPeriod" data-dunhuang-format="seconds" type="range" min="3" max="16" value="7" step="0.5">
                        <label class="main-dunhuang-switch"><span>丁达尔光</span><input type="checkbox" data-dunhuang-toggle="tyndallEnabled" checked></label>
                        <label for="mainDunhuangTyndall"><span>散射强度</span><output data-dunhuang-output="tyndallStrength">0.82</output></label>
                        <input id="mainDunhuangTyndall" data-dunhuang-setting="tyndallStrength" data-dunhuang-format="fixed2" type="range" min="0" max="1.5" value="0.82" step="0.02">
                        <label for="mainDunhuangBeamSpread"><span>光束展开</span><output data-dunhuang-output="beamSpread">0.34</output></label>
                        <input id="mainDunhuangBeamSpread" data-dunhuang-setting="beamSpread" data-dunhuang-format="fixed2" type="range" min="0.08" max="0.65" value="0.34" step="0.01">
                    </fieldset>

                    <div class="main-dunhuang-actions">
                        <button type="button" data-dunhuang-action="gust">扬起金尘</button>
                        <button type="button" data-dunhuang-action="pause" aria-pressed="false">暂停</button>
                        <button type="button" data-dunhuang-action="reset">重置</button>
                    </div>
                </div>
            </details>
        </section>

        <section class="quick-section site-section" aria-labelledby="quickTitle">
            <div class="section-heading site-section-heading"><div><p class="site-kicker">SHORTCUT TICKETS</p><h2 id="quickTitle">快速开始</h2></div><p>选择一张行动签，直接进入今天要处理的事情。</p></div>
            <div class="quick-grid">
                <a class="quick-item primary" href="/editor"><span>＋</span><strong>写博客</strong><small>记录现在的想法</small></a>
                <a class="quick-item" href="/goal"><span>⚑</span><strong>目标</strong><small>查看下一步</small></a>
                <a class="quick-item" href="/exercise"><span>↗</span><strong>锻炼</strong><small>记录一次运动</small></a>
                <a class="quick-item" href="/reading"><span>▤</span><strong>读书</strong><small>继续阅读计划</small></a>
                <a class="quick-item" href="/products"><span>✦</span><strong>产品库</strong><small>拆解并积累灵感</small></a>
                <a class="quick-item" href="/clipboard"><span>⌘</span><strong>内贴板</strong><small>跨设备传递内容</small></a>
            </div>
        </section>

        <section class="continue-section site-section" aria-labelledby="continueTitle">
            <div class="section-heading site-section-heading">
                <div><p class="site-kicker">RECENT ARCHIVE</p><h2 id="continueTitle">继续阅读</h2></div>
                <a href="/link">查看全部</a>
            </div>
            {{if .RECENT_LINKS}}
            <div class="recent-grid">
                {{range .RECENT_LINKS}}
                <a class="recent-card{{if .IMAGE_URL}} has-media{{end}}" href="{{.URL}}">
                    {{if .IMAGE_URL}}
                    <img class="recent-card-image" src="{{.IMAGE_URL}}" alt="" loading="lazy" decoding="async">
                    {{end}}
                    <span class="recent-card-body">
                        <time>{{.ACCESS_TIME}}</time>
                        <strong>{{.DESC}}</strong>
                        <span class="recent-preview">{{.PREVIEW}}</span>
                    </span>
                </a>
                {{end}}
            </div>
            {{else}}
            <div class="recent-empty site-empty-state">
                <span class="site-symbol" data-symbol="empty" aria-hidden="true"></span>
                <p>还没有阅读记录。</p>
                <a href="/link">去 BLOG 看看</a>
            </div>
            {{end}}
        </section>

    </main>

    <aside class="daily-quote" aria-label="今日格言">
        <div class="daily-quote-rule"></div>
        <p class="daily-quote-kicker">今日格言</p>
        <blockquote id="dailyQuote">把今天能完成的一件小事，做到确实完成。</blockquote>
        <p id="dailyQuoteSource" class="daily-quote-source">— 给正在行动的自己</p>
        <span class="daily-quote-mark" aria-hidden="true">“</span>
    </aside>

    <script src="/js/visual_symbol_motion.js?v=1"></script>
    <script src="/js/celadon_rain_lab.js?v=10"></script>
    <script src="/js/dunhuang_motion_lab.js?v=4"></script>
    <script src="/js/main.js?v=quote-1"></script>
</body>
</html>
